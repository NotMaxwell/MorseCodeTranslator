# Point clangd at ESP-IDF's compile database (generated by `idf.py build`) and
# strip the GCC/Xtensa-only flags clang doesn't understand.
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -mno-target-align
    - -mlongcalls
    - -fno-shrink-wrap
    - -Wunused-but-set-variable=1
    - -fmacro-prefix-map=*
    - -std=gnu++26
  Add:
    - -std=gnu++2c
